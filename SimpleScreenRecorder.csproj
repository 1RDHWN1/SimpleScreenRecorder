<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>SimpleScreenRecorder.Program</StartupObject>
    <AssemblyName>SimpleScreenRecorder</AssemblyName>
    <RootNamespace>SimpleScreenRecorder</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>You</Authors>
    <Description>A lightweight screen recording application for Windows</Description>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- NAudio for audio recording -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    
    <!-- For FFmpeg wrapper (optional, or use CLI directly) -->
    <PackageReference Include="FFMpegCore" Version="6.0.0" />
  </ItemGroup>

</Project>
